{
  "manifest_version": 3,
  "name": "RTSP Web Player Runtime",
  "version": "0.1.18",
  "key": "",
  "description": "Native Go RTSP runtime + WebCodecs player component for H.264 RTSP streams.",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "ws://127.0.0.1/*"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "RTSP Web Player",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/rtsp-component.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["player/player.html", "player/player.js", "player/player.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
